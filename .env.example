# Frontend runs fully on mocks when true (no Supabase / backend needed).
NEXT_PUBLIC_USE_MOCKS=true
# Optional: 0..1 chance that mock upload/analyze fails, to demo Retry.
NEXT_PUBLIC_MOCK_FAIL_RATE=0

# Public Supabase values (safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase → Connect → Transaction pooler (порт 6543)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
ANTHROPIC_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_DAILY_LIMIT=500
DEMO_FALLBACK=false

# Frontend: true = every API call is mocked (no Supabase needed). Default: only endpoints not yet live are mocked.
NEXT_PUBLIC_USE_MOCKS=false
# Optional: 0..1 chance that mocked upload/analyze fails, to demo Retry.
NEXT_PUBLIC_MOCK_FAIL_RATE=0
